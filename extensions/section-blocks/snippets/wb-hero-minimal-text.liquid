{% comment %} Renders the minimal-text design for wb-hero-banner.liquid {% endcomment %}
<div class="wb-hero wb-hero--minimal-text wb-hero-{{ block.id }}">
  <div class="wb-hero__inner wb-hero__inner--minimal">
    {% if block.settings.heading != blank %}
      <h2 class="wb-hero__heading wb-hero__heading--minimal">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.button_label != blank %}
      <a href="{{ block.settings.button_link }}" class="wb-hero__button wb-hero__button--minimal wb-btn">
        {{ block.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>
