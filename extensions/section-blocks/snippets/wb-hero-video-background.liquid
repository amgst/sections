{% comment %} Renders the video-background design for wb-hero-banner.liquid {% endcomment %}
<div
  class="wb-hero wb-hero--video-background"
  style="color: {{ block.settings.text_color }}; padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px;"
>
  <div
    class="wb-hero__video-wrap"
    {% if block.settings.bg_video_poster != blank %}
      style="background-image: url({{ block.settings.bg_video_poster | image_url: width: 1600 }});"
    {% endif %}
  >
    {% if block.settings.bg_video != blank %}
      {{ block.settings.bg_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'wb-hero__video' }}
    {% endif %}
    <div class="wb-hero__video-overlay"></div>
  </div>
  <div class="wb-hero__inner">
    {% if block.settings.heading != blank %}
      <h2 class="wb-hero__heading">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.subheading != blank %}
      <p class="wb-hero__subheading">{{ block.settings.subheading }}</p>
    {% endif %}
    {% if block.settings.button_label != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="wb-hero__button wb-btn"
        style="background-color: {{ block.settings.button_background }}; color: {{ block.settings.button_text_color }};"
      >
        {{ block.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>
