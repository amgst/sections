{% comment %} Renders the split-image design for wb-hero-banner.liquid {% endcomment %}
<div
  class="wb-hero wb-hero--split-image wb-hero--image-{{ block.settings.split_image_position }}"
  style="background-color: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px;"
>
  <div class="wb-hero__split">
    <div class="wb-hero__split-media">
      {% if block.settings.split_image != blank %}
        {{ block.settings.split_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'wb-hero__split-image' }}
      {% else %}
        <div class="wb-hero__split-placeholder" aria-hidden="true"></div>
      {% endif %}
    </div>
    <div class="wb-hero__split-content">
      {% if block.settings.heading != blank %}
        <h2 class="wb-hero__heading">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="wb-hero__subheading">{{ block.settings.subheading }}</p>
      {% endif %}
      {% if block.settings.button_label != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="wb-hero__button wb-btn"
          style="background-color: {{ block.settings.button_background }}; color: {{ block.settings.button_text_color }};"
        >
          {{ block.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>
