{% comment %} Renders the split-image design for wb-hero-banner.liquid {% endcomment %}
<div class="wb-hero wb-hero--split-image wb-hero--image-{{ block.settings.split_image_position }} wb-hero-{{ block.id }}">
  <div class="wb-hero__split">
    <div class="wb-hero__split-media">
      {% if block.settings.split_image != blank %}
        {{ block.settings.split_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'wb-hero__split-image' }}
      {% else %}
        <div class="wb-hero__split-placeholder" aria-hidden="true"></div>
      {% endif %}
    </div>
    <div class="wb-hero__split-content">
      {% if block.settings.heading != blank %}
        <h2 class="wb-hero__heading">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="wb-hero__subheading">{{ block.settings.subheading }}</p>
      {% endif %}
      {% if block.settings.button_label != blank %}
        <a href="{{ block.settings.button_link }}" class="wb-hero__button wb-btn">
          {{ block.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>
