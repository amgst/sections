{% comment %} Renders the announcement-overlay design for wb-hero-banner.liquid {% endcomment %}
<div
  class="wb-hero wb-hero--announcement-overlay"
  style="background-color: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px;"
>
  <div class="wb-hero__inner">
    {% if block.settings.overlay_badge_text != blank %}
      <span class="wb-hero__badge wb-badge" style="background-color: {{ block.settings.button_background }}; color: {{ block.settings.button_text_color }};">
        {{ block.settings.overlay_badge_text }}
      </span>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h2 class="wb-hero__heading">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.subheading != blank %}
      <p class="wb-hero__subheading">{{ block.settings.subheading }}</p>
    {% endif %}
    {% if block.settings.button_label != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="wb-hero__button wb-btn"
        style="background-color: {{ block.settings.button_background }}; color: {{ block.settings.button_text_color }};"
      >
        {{ block.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>
