{% comment %} Renders the classic-centered design for wb-hero-banner.liquid {% endcomment %}
<div class="wb-hero wb-hero--classic-centered wb-hero-{{ block.id }}">
  <div class="wb-hero__inner">
    {% if block.settings.heading != blank %}
      <h2 class="wb-hero__heading">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.subheading != blank %}
      <p class="wb-hero__subheading">{{ block.settings.subheading }}</p>
    {% endif %}
    {% if block.settings.button_label != blank %}
      <a href="{{ block.settings.button_link }}" class="wb-hero__button wb-btn">
        {{ block.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>
