<div class="wb-testimonials" style="background-color: {{ block.settings.background_color }}; color: {{ block.settings.text_color }};">
  {% if block.settings.heading != blank %}
    <h2 class="wb-testimonials__heading">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="wb-testimonials__grid">
    {% if block.settings.testimonial_1_quote != blank %}
      <blockquote class="wb-testimonials__card">
        <p>&ldquo;{{ block.settings.testimonial_1_quote }}&rdquo;</p>
        {% if block.settings.testimonial_1_author != blank %}
          <cite>{{ block.settings.testimonial_1_author }}</cite>
        {% endif %}
      </blockquote>
    {% endif %}
    {% if block.settings.testimonial_2_quote != blank %}
      <blockquote class="wb-testimonials__card">
        <p>&ldquo;{{ block.settings.testimonial_2_quote }}&rdquo;</p>
        {% if block.settings.testimonial_2_author != blank %}
          <cite>{{ block.settings.testimonial_2_author }}</cite>
        {% endif %}
      </blockquote>
    {% endif %}
    {% if block.settings.testimonial_3_quote != blank %}
      <blockquote class="wb-testimonials__card">
        <p>&ldquo;{{ block.settings.testimonial_3_quote }}&rdquo;</p>
        {% if block.settings.testimonial_3_author != blank %}
          <cite>{{ block.settings.testimonial_3_author }}</cite>
        {% endif %}
      </blockquote>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "target": "section",
  "stylesheet": "testimonials.css",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "header", "content": "Testimonial 1" },
    { "type": "textarea", "id": "testimonial_1_quote", "label": "Quote", "default": "This app made adding new sections so easy." },
    { "type": "text", "id": "testimonial_1_author", "label": "Author", "default": "Happy merchant" },
    { "type": "header", "content": "Testimonial 2" },
    { "type": "textarea", "id": "testimonial_2_quote", "label": "Quote" },
    { "type": "text", "id": "testimonial_2_author", "label": "Author" },
    { "type": "header", "content": "Testimonial 3" },
    { "type": "textarea", "id": "testimonial_3_quote", "label": "Quote" },
    { "type": "text", "id": "testimonial_3_author", "label": "Author" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f9fafb" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111827" }
  ]
}
{% endschema %}
