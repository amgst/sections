{{ 'wb-common.css' | asset_url | stylesheet_tag }}

{% case block.settings.design %}
  {% when 'quote-with-photo' %}
    {% render 'wb-testimonials-quote-photo', block: block %}
  {% when 'stat-highlight' %}
    {% render 'wb-testimonials-stat-highlight', block: block %}
  {% when 'video-testimonial' %}
    {% render 'wb-testimonials-video', block: block %}
  {% else %}
    {% render 'wb-testimonials-single-quote', block: block %}
{% endcase %}

{% schema %}
{
  "name": "wb-Testimonials",
  "target": "section",
  "stylesheet": "wb-testimonials.css",
  "settings": [
    {
      "type": "select",
      "id": "design",
      "label": "Design",
      "default": "single-quote",
      "options": [
        { "value": "single-quote", "label": "Single quote" },
        { "value": "quote-with-photo", "label": "Quote with photo" },
        { "value": "stat-highlight", "label": "Stat highlight" },
        { "value": "video-testimonial", "label": "Video testimonial" }
      ]
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "This app made adding new sections so easy." },
    { "type": "text", "id": "author", "label": "Author", "default": "Happy merchant" },
    { "type": "text", "id": "author_role", "label": "Author role or store name" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f9fafb" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111827" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#008060" },

    { "type": "header", "content": "Quote with photo design", "visible_if": "{{ block.settings.design == 'quote-with-photo' }}" },
    { "type": "image_picker", "id": "author_photo", "label": "Author photo", "visible_if": "{{ block.settings.design == 'quote-with-photo' }}" },

    { "type": "header", "content": "Stat highlight design", "visible_if": "{{ block.settings.design == 'stat-highlight' }}" },
    { "type": "text", "id": "stat_value", "label": "Stat value", "default": "4.9/5", "visible_if": "{{ block.settings.design == 'stat-highlight' }}" },
    { "type": "text", "id": "stat_label", "label": "Stat label", "default": "Average rating", "visible_if": "{{ block.settings.design == 'stat-highlight' }}" },

    { "type": "header", "content": "Video testimonial design", "visible_if": "{{ block.settings.design == 'video-testimonial' }}" },
    { "type": "video", "id": "testimonial_video", "label": "Testimonial video", "visible_if": "{{ block.settings.design == 'video-testimonial' }}" },
    { "type": "image_picker", "id": "video_poster", "label": "Poster image", "visible_if": "{{ block.settings.design == 'video-testimonial' }}" }
  ],
  "presets": [
    { "name": "Testimonial — Single quote", "category": "Testimonial", "settings": { "design": "single-quote" } },
    { "name": "Testimonial — Quote with photo", "category": "Testimonial", "settings": { "design": "quote-with-photo" } },
    { "name": "Testimonial — Stat highlight", "category": "Testimonial", "settings": { "design": "stat-highlight" } },
    { "name": "Testimonial — Video testimonial", "category": "Testimonial", "settings": { "design": "video-testimonial" } }
  ]
}
{% endschema %}
