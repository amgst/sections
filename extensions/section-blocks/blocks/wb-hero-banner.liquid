{{ 'wb-common.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign button_style = block.settings.button_style
  assign width = block.settings.width
-%}

{% style %}
  .wb-hero-{{ block.id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding-top: {{ block.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ block.settings.padding_bottom | times: 0.7 | round: 0 }}px;
    padding-left: {{ block.settings.padding_horizontal | times: 0.5 }}rem;
    padding-right: {{ block.settings.padding_horizontal | times: 0.5 }}rem;
    border-radius: {{ block.settings.section_radius }}px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
  }
  .wb-hero-{{ block.id }} .wb-hero__heading {
    font-size: {{ block.settings.heading_size_mobile }}px;
    line-height: 1.15;
  }
  .wb-hero-{{ block.id }} .wb-hero__subheading {
    font-size: {{ block.settings.subheading_size | times: 0.85 | round: 0 }}px;
    line-height: 1.5;
    margin-top: 16px;
  }
  .wb-hero-{{ block.id }} .wb-hero__button,
  .wb-hero-{{ block.id }} .wb-hero__badge {
    color: {{ block.settings.button_text_color }};
  }
  .wb-hero-{{ block.id }} .wb-hero__button {
    font-size: {{ block.settings.button_size_mobile }}px;
    border-radius: {{ block.settings.button_radius }}px;
    margin-top: 22px;
    {% unless button_style == 'link' %}
      padding: {{ block.settings.button_padding_vertical | times: 0.85 | round: 0 }}px {{ block.settings.button_padding_horizontal | times: 0.85 | round: 0 }}px;
    {% endunless %}
  }
  .wb-hero-{{ block.id }} .wb-hero__button:hover {
    color: {{ block.settings.button_text_hover_color }};
  }
  {% if button_style == 'non_outline' or button_style == 'non_outline_arrow' %}
    .wb-hero-{{ block.id }} .wb-hero__button {
      background-color: {{ block.settings.button_bg_color }};
    }
    .wb-hero-{{ block.id }} .wb-hero__button:hover {
      background-color: {{ block.settings.button_bg_hover_color }};
    }
  {% elsif button_style == 'outline' or button_style == 'outline_arrow' %}
    .wb-hero-{{ block.id }} .wb-hero__button {
      background-color: {{ block.settings.button_bg_color }};
      border: 2px solid {{ block.settings.button_border_color }};
    }
    .wb-hero-{{ block.id }} .wb-hero__button:hover {
      background-color: {{ block.settings.button_bg_hover_color }};
      border-color: {{ block.settings.button_border_hover_color }};
    }
  {% endif %}
  .wb-hero-{{ block.id }} .wb-hero__badge {
    background-color: {{ block.settings.button_bg_color }};
  }

  @media (min-width: 750px) {
    .wb-hero-{{ block.id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
      padding-left: {{ block.settings.padding_horizontal }}rem;
      padding-right: {{ block.settings.padding_horizontal }}rem;
    }
    .wb-hero-{{ block.id }} .wb-hero__heading {
      font-size: {{ block.settings.heading_size }}px;
    }
    .wb-hero-{{ block.id }} .wb-hero__subheading {
      font-size: {{ block.settings.subheading_size }}px;
      margin-top: 20px;
    }
    .wb-hero-{{ block.id }} .wb-hero__button {
      font-size: {{ block.settings.button_size }}px;
      margin-top: 28px;
      {% unless button_style == 'link' %}
        padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
      {% endunless %}
    }
  }

  {% if width == 'page' %}
    .wb-hero-{{ block.id }} .wb-hero__inner,
    .wb-hero-{{ block.id }} .wb-hero__split {
      max-width: var(--page-width, 1200px);
    }
  {% endif %}

  {% if block.settings.heading_custom_font %}
    {{ block.settings.heading_font | font_face: font_display: 'swap' }}
    .wb-hero-{{ block.id }} .wb-hero__heading {
      font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
      font-weight: {{ block.settings.heading_font.weight }};
      font-style: {{ block.settings.heading_font.style }};
    }
  {% endif %}

  {% if block.settings.button_custom_font %}
    {{ block.settings.button_font | font_face: font_display: 'swap' }}
    .wb-hero-{{ block.id }} .wb-hero__button {
      font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
      font-weight: {{ block.settings.button_font.weight }};
      font-style: {{ block.settings.button_font.style }};
    }
  {% endif %}
{% endstyle %}

{% case block.settings.design %}
  {% when 'split-image' %}
    {% render 'wb-hero-split-image', block: block %}
  {% when 'video-background' %}
    {% render 'wb-hero-video-background', block: block %}
  {% when 'minimal-text' %}
    {% render 'wb-hero-minimal-text', block: block %}
  {% when 'announcement-overlay' %}
    {% render 'wb-hero-announcement-overlay', block: block %}
  {% else %}
    {% render 'wb-hero-classic-centered', block: block %}
{% endcase %}

{% schema %}
{
  "name": "wb-Hero",
  "target": "section",
  "stylesheet": "wb-hero-banner.css",
  "settings": [
    {
      "type": "select",
      "id": "design",
      "label": "Design",
      "default": "classic-centered",
      "options": [
        { "value": "classic-centered", "label": "Classic centered" },
        { "value": "split-image", "label": "Split image" },
        { "value": "video-background", "label": "Video background" },
        { "value": "minimal-text", "label": "Minimal text" },
        { "value": "announcement-overlay", "label": "Announcement overlay" }
      ]
    },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Create store sections in minutes" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Add this Hero section to any page from the theme editor." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Heading & subheading style" },
    { "type": "checkbox", "id": "heading_custom_font", "label": "Use custom font for heading", "default": false },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font family", "default": "helvetica_n7", "visible_if": "{{ block.settings.heading_custom_font }}" },
    { "type": "range", "id": "heading_size", "label": "Heading font size", "min": 20, "max": 96, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading font size — mobile", "min": 16, "max": 72, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "subheading_size", "label": "Subheading font size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 18 },

    { "type": "header", "content": "Button style" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "default": "non_outline",
      "options": [
        { "value": "link", "label": "Link" },
        { "value": "non_outline", "label": "Solid" },
        { "value": "non_outline_arrow", "label": "Solid + arrow" },
        { "value": "outline", "label": "Outline" },
        { "value": "outline_arrow", "label": "Outline + arrow" }
      ]
    },
    { "type": "checkbox", "id": "button_custom_font", "label": "Use custom font", "default": false },
    { "type": "font_picker", "id": "button_font", "label": "Font family", "default": "helvetica_n7", "visible_if": "{{ block.settings.button_custom_font }}" },
    { "type": "range", "id": "button_size", "label": "Font size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "button_size_mobile", "label": "Font size — mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "button_radius", "label": "Roundness", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 100, "visible_if": "{{ block.settings.button_style != 'link' }}" },
    { "type": "checkbox", "id": "button_advanced", "label": "Advanced settings" },
    { "type": "range", "id": "button_padding_horizontal", "label": "Padding horizontal", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 28, "visible_if": "{{ block.settings.button_style != 'link' and block.settings.button_advanced }}" },
    { "type": "range", "id": "button_padding_vertical", "label": "Padding vertical", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 14, "visible_if": "{{ block.settings.button_style != 'link' and block.settings.button_advanced }}" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#0f172a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#0f172a" },
    { "type": "color", "id": "button_text_hover_color", "label": "Button text — hover", "default": "#0f172a" },
    { "type": "color", "id": "button_bg_color", "label": "Button background", "default": "#ffffff", "visible_if": "{{ block.settings.button_style != 'link' }}" },
    { "type": "color", "id": "button_bg_hover_color", "label": "Button background — hover", "default": "#e5e7eb", "visible_if": "{{ block.settings.button_style != 'link' }}" },
    { "type": "color", "id": "button_border_color", "label": "Button border", "default": "#ffffff", "visible_if": "{{ block.settings.button_style == 'outline' or block.settings.button_style == 'outline_arrow' }}" },
    { "type": "color", "id": "button_border_hover_color", "label": "Button border — hover", "default": "#e5e7eb", "visible_if": "{{ block.settings.button_style == 'outline' or block.settings.button_style == 'outline_arrow' }}" },

    { "type": "header", "content": "Section" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "full",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "full", "label": "Full" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_horizontal", "label": "Padding sides", "min": 0, "max": 10, "step": 0.5, "unit": "rem", "default": 3 },
    { "type": "range", "id": "section_radius", "label": "Roundness", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "border_thickness", "label": "Border thickness", "min": 0, "max": 10, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#0f172a" },

    { "type": "header", "content": "Design options", "visible_if": "{{ block.settings.design == 'split-image' or block.settings.design == 'video-background' or block.settings.design == 'announcement-overlay' }}" },
    { "type": "image_picker", "id": "split_image", "label": "Image", "visible_if": "{{ block.settings.design == 'split-image' }}" },
    {
      "type": "select",
      "id": "split_image_position",
      "label": "Image position",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "visible_if": "{{ block.settings.design == 'split-image' }}"
    },

    { "type": "video", "id": "bg_video", "label": "Background video", "visible_if": "{{ block.settings.design == 'video-background' }}" },
    { "type": "image_picker", "id": "bg_video_poster", "label": "Poster image (shown until video loads)", "visible_if": "{{ block.settings.design == 'video-background' }}" },

    { "type": "text", "id": "overlay_badge_text", "label": "Badge text", "default": "Limited time", "visible_if": "{{ block.settings.design == 'announcement-overlay' }}" }
  ]
}
{% endschema %}
