{{ 'wb-common.css' | asset_url | stylesheet_tag }}

{% case block.settings.design %}
  {% when 'split-image' %}
    {% render 'wb-hero-split-image', block: block %}
  {% when 'video-background' %}
    {% render 'wb-hero-video-background', block: block %}
  {% when 'minimal-text' %}
    {% render 'wb-hero-minimal-text', block: block %}
  {% when 'announcement-overlay' %}
    {% render 'wb-hero-announcement-overlay', block: block %}
  {% else %}
    {% render 'wb-hero-classic-centered', block: block %}
{% endcase %}

{% schema %}
{
  "name": "wb-Hero",
  "target": "section",
  "stylesheet": "wb-hero-banner.css",
  "settings": [
    {
      "type": "select",
      "id": "design",
      "label": "Design",
      "default": "classic-centered",
      "options": [
        { "value": "classic-centered", "label": "Classic centered" },
        { "value": "split-image", "label": "Split image" },
        { "value": "video-background", "label": "Video background" },
        { "value": "minimal-text", "label": "Minimal text" },
        { "value": "announcement-overlay", "label": "Announcement overlay" }
      ]
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Create store sections in minutes" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Add this Hero section to any page from the theme editor." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Colors & spacing" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#0f172a" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#0f172a" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },

    { "type": "header", "content": "Split image design", "visible_if": "{{ block.settings.design == 'split-image' }}" },
    { "type": "image_picker", "id": "split_image", "label": "Image", "visible_if": "{{ block.settings.design == 'split-image' }}" },
    {
      "type": "select",
      "id": "split_image_position",
      "label": "Image position",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "visible_if": "{{ block.settings.design == 'split-image' }}"
    },

    { "type": "header", "content": "Video background design", "visible_if": "{{ block.settings.design == 'video-background' }}" },
    { "type": "video", "id": "bg_video", "label": "Background video", "visible_if": "{{ block.settings.design == 'video-background' }}" },
    { "type": "image_picker", "id": "bg_video_poster", "label": "Poster image (shown until video loads)", "visible_if": "{{ block.settings.design == 'video-background' }}" },

    { "type": "header", "content": "Announcement overlay design", "visible_if": "{{ block.settings.design == 'announcement-overlay' }}" },
    { "type": "text", "id": "overlay_badge_text", "label": "Badge text", "default": "Limited time", "visible_if": "{{ block.settings.design == 'announcement-overlay' }}" }
  ],
  "presets": [
    { "name": "Hero — Classic centered", "category": "Hero", "settings": { "design": "classic-centered" } },
    { "name": "Hero — Split image", "category": "Hero", "settings": { "design": "split-image" } },
    { "name": "Hero — Video background", "category": "Hero", "settings": { "design": "video-background" } },
    { "name": "Hero — Minimal text", "category": "Hero", "settings": { "design": "minimal-text" } },
    { "name": "Hero — Announcement overlay", "category": "Hero", "settings": { "design": "announcement-overlay" } }
  ]
}
{% endschema %}
