<div class="wb-hero" style="background-color: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px;">
  <div class="wb-hero__inner">
    {% if block.settings.heading != blank %}
      <h2 class="wb-hero__heading">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.subheading != blank %}
      <p class="wb-hero__subheading">{{ block.settings.subheading }}</p>
    {% endif %}
    {% if block.settings.button_label != blank %}
      <a href="{{ block.settings.button_link }}" class="wb-hero__button" style="background-color: {{ block.settings.button_background }}; color: {{ block.settings.button_text_color }};">
        {{ block.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "wb-Hero Banner",
  "target": "section",
  "stylesheet": "wb-hero-banner.css",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Create store sections in minutes" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Add this Hero Banner section to any page from the theme editor." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#0f172a" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#0f172a" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
