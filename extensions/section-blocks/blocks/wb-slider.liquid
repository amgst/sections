{{ 'wb-common.css' | asset_url | stylesheet_tag }}

{% style %}
  .wb-slider-{{ block.id }} {
    padding-top: {{ block.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ block.settings.padding_bottom | times: 0.7 | round: 0 }}px;
  }
  .wb-slider-{{ block.id }} .wb-slider__heading {
    font-size: {{ block.settings.heading_size_mobile }}px;
    color: {{ block.settings.heading_color }};
  }
  .wb-slider-{{ block.id }} .wb-slider__price { color: {{ block.settings.price_color }}; }
  .wb-slider-{{ block.id }} .wb-slider__button {
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
  }
  .wb-slider-{{ block.id }} .wb-slider__tab.is-active { box-shadow: inset 0 -3px 0 {{ block.settings.tab_active_color }}; }
  {% for i in (1..3) %}
    {% capture bg_key %}slide_{{ i }}_background_color{% endcapture %}
    .wb-slider-{{ block.id }} .wb-slider__slide--{{ i }} { background-color: {{ block.settings[bg_key] }}; }
  {% endfor %}

  @media (min-width: 750px) {
    .wb-slider-{{ block.id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
    .wb-slider-{{ block.id }} .wb-slider__heading {
      font-size: {{ block.settings.heading_size }}px;
    }
  }
{% endstyle %}

<div
  class="wb-slider wb-slider-{{ block.id }}"
  data-wb-slider
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed | times: 1000 }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ block.settings.slide_1_heading | default: 'Slides' }}"
>
  <div class="wb-slider__slides">
    {% for i in (1..3) %}
      {% capture heading_key %}slide_{{ i }}_heading{% endcapture %}
      {% assign heading = block.settings[heading_key] %}
      {% if heading != blank %}
        {% capture image_key %}slide_{{ i }}_image{% endcapture %}
        {% capture feature_1_key %}slide_{{ i }}_feature_1{% endcapture %}
        {% capture feature_2_key %}slide_{{ i }}_feature_2{% endcapture %}
        {% capture price_key %}slide_{{ i }}_price{% endcapture %}
        {% capture button_label_key %}slide_{{ i }}_button_label{% endcapture %}
        {% capture button_link_key %}slide_{{ i }}_button_link{% endcapture %}
        {% assign image = block.settings[image_key] %}
        {% assign feature_1 = block.settings[feature_1_key] %}
        {% assign feature_2 = block.settings[feature_2_key] %}
        {% assign price = block.settings[price_key] %}
        {% assign button_label = block.settings[button_label_key] %}
        {% assign button_link = block.settings[button_link_key] %}
        <div
          id="wb-slider-{{ block.id }}-slide-{{ i }}"
          class="wb-slider__slide wb-slider__slide--{{ i }}{% if forloop.first %} is-active{% endif %}"
          data-slide="{{ i }}"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ heading }}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
        >
          <div class="wb-slider__content">
            <h2 class="wb-slider__heading">{{ heading }}</h2>
            {% if feature_1 != blank or feature_2 != blank %}
              <div class="wb-slider__features">
                {% if feature_1 != blank %}
                  <div class="wb-slider__feature">{{ feature_1 }}</div>
                {% endif %}
                {% if feature_2 != blank %}
                  <div class="wb-slider__feature">{{ feature_2 }}</div>
                {% endif %}
              </div>
            {% endif %}
            {% if price != blank %}
              <div class="wb-slider__price">{{ price }}</div>
            {% endif %}
            {% if button_label != blank %}
              <a href="{{ button_link }}" class="wb-slider__button wb-btn">{{ button_label }}</a>
            {% endif %}
          </div>
          <div class="wb-slider__media">
            {% if image != blank %}
              {% if forloop.first %}
                {{ image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'wb-slider__image' }}
              {% else %}
                {{ image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'wb-slider__image' }}
              {% endif %}
            {% else %}
              <div class="wb-slider__image-placeholder" aria-hidden="true"></div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    <button type="button" class="wb-slider__arrow wb-slider__arrow--prev" data-slide-prev aria-label="Previous slide">
      <svg width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M9 1L2 8l7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button type="button" class="wb-slider__arrow wb-slider__arrow--next" data-slide-next aria-label="Next slide">
      <svg width="10" height="16" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <div class="wb-slider__tabs" role="tablist">
    {% for i in (1..3) %}
      {% capture heading_key %}slide_{{ i }}_heading{% endcapture %}
      {% capture tab_label_key %}slide_{{ i }}_tab_label{% endcapture %}
      {% assign heading = block.settings[heading_key] %}
      {% assign tab_label = block.settings[tab_label_key] %}
      {% if heading != blank %}
        <button
          type="button"
          class="wb-slider__tab{% if forloop.first %} is-active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="wb-slider-{{ block.id }}-slide-{{ i }}"
        >
          {{ tab_label | default: heading }}
        </button>
      {% endif %}
    {% endfor %}
  </div>

  <div class="wb-slider__sr-status" aria-live="polite" aria-atomic="true"></div>
</div>

{% schema %}
{
  "name": "wb-Slider",
  "target": "section",
  "stylesheet": "wb-slider.css",
  "javascript": "wb-slider.js",
  "settings": [
    { "type": "header", "content": "Behavior" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay slides", "default": false },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6, "visible_if": "{{ block.settings.autoplay }}" },

    { "type": "header", "content": "Style" },
    { "type": "range", "id": "heading_size", "label": "Heading font size", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading font size — mobile", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "color", "id": "price_color", "label": "Price accent color", "default": "#fde047" },
    { "type": "color", "id": "button_bg_color", "label": "Button background", "default": "#fde047" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#111827" },
    { "type": "color", "id": "tab_active_color", "label": "Active tab underline", "default": "#fde047" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },

    { "type": "header", "content": "Slide 1" },
    { "type": "image_picker", "id": "slide_1_image", "label": "Image" },
    { "type": "color", "id": "slide_1_background_color", "label": "Background color", "default": "#3a8f5c" },
    { "type": "text", "id": "slide_1_heading", "label": "Heading", "default": "Built for every ride" },
    { "type": "text", "id": "slide_1_feature_1", "label": "Feature 1", "default": "Best quality tires" },
    { "type": "text", "id": "slide_1_feature_2", "label": "Feature 2", "default": "2-year warranty" },
    { "type": "text", "id": "slide_1_price", "label": "Price", "default": "Starting at $999.00" },
    { "type": "text", "id": "slide_1_button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "slide_1_button_link", "label": "Button link" },
    { "type": "text", "id": "slide_1_tab_label", "label": "Tab label", "default": "Slide one" },

    { "type": "header", "content": "Slide 2" },
    { "type": "image_picker", "id": "slide_2_image", "label": "Image" },
    { "type": "color", "id": "slide_2_background_color", "label": "Background color", "default": "#2563eb" },
    { "type": "text", "id": "slide_2_heading", "label": "Heading", "default": "Engineered to last" },
    { "type": "text", "id": "slide_2_feature_1", "label": "Feature 1", "default": "Lightweight frame" },
    { "type": "text", "id": "slide_2_feature_2", "label": "Feature 2", "default": "Fast charging battery" },
    { "type": "text", "id": "slide_2_price", "label": "Price", "default": "Starting at $1,299.00" },
    { "type": "text", "id": "slide_2_button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "slide_2_button_link", "label": "Button link" },
    { "type": "text", "id": "slide_2_tab_label", "label": "Tab label", "default": "Slide two" },

    { "type": "header", "content": "Slide 3" },
    { "type": "image_picker", "id": "slide_3_image", "label": "Image" },
    { "type": "color", "id": "slide_3_background_color", "label": "Background color", "default": "#111827" },
    { "type": "text", "id": "slide_3_heading", "label": "Heading", "default": "Ride further, worry less" },
    { "type": "text", "id": "slide_3_feature_1", "label": "Feature 1", "default": "Extended range battery" },
    { "type": "text", "id": "slide_3_feature_2", "label": "Feature 2", "default": "All-weather tires" },
    { "type": "text", "id": "slide_3_price", "label": "Price", "default": "Starting at $1,599.00" },
    { "type": "text", "id": "slide_3_button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "slide_3_button_link", "label": "Button link" },
    { "type": "text", "id": "slide_3_tab_label", "label": "Tab label", "default": "Slide three" }
  ]
}
{% endschema %}
