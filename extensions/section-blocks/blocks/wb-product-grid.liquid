<div class="wb-grid-wrap">
  {% if block.settings.heading != blank %}
    <h2 class="wb-grid-heading">{{ block.settings.heading }}</h2>
  {% endif %}

  {% assign wb_grid_collection = block.settings.collection | default: collections.all %}
  {% if wb_grid_collection.products.size > 0 %}
    <div class="wb-grid" style="--wb-columns: {{ block.settings.columns }};">
      {% for product in wb_grid_collection.products limit: block.settings.products_to_show %}
        <div class="wb-grid-card">
          <a href="{{ product.url }}" class="wb-grid-card__media">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy' }}
            {% endif %}
          </a>
          <a href="{{ product.url }}" class="wb-grid-card__title">{{ product.title }}</a>
          <div class="wb-grid-card__price">{{ product.price | money }}</div>
          {% form 'product', product, class: 'wb-grid-card__form' %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="wb-grid-card__button" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
              {% if product.selected_or_first_available_variant.available %}
                Quick add
              {% else %}
                Sold out
              {% endif %}
            </button>
          {% endform %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="wb-grid-empty">
      <svg class="wb-grid-empty__icon" width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="3" y="3" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
        <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
        <rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
        <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <p class="wb-grid-empty__title">No products to show</p>
      <p class="wb-grid-empty__hint">Add products to your store, or choose a specific collection in this block's settings.</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "wb-Product Grid",
  "target": "section",
  "stylesheet": "wb-product-grid.css",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the collection" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 }
  ]
}
{% endschema %}
